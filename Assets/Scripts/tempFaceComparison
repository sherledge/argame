using UnityEngine;

public static class FaceComparison
{
    // Threshold: 0.65 is a balanced starting point
    public static float MATCH_THRESHOLD = 0.85f;

    public static bool IsSamePerson(float[] embeddingA, float[] embeddingB)
    {
        if (embeddingA == null || embeddingB == null) return false;
        
        // We calculate similarity but we don't force the user to handle the 'out' variable
        float similarity = CosineSimilarity(embeddingA, embeddingB);
        return similarity > MATCH_THRESHOLD;
    }

    private static float CosineSimilarity(float[] vecA, float[] vecB)
    {
        if (vecA.Length != vecB.Length) return 0;

        float dotProduct = 0f;
        float magA = 0f;
        float magB = 0f;

        for (int i = 0; i < vecA.Length; i++)
        {
            dotProduct += vecA[i] * vecB[i];
            magA += vecA[i] * vecA[i];
            magB += vecB[i] * vecB[i];
        }

        return dotProduct / (Mathf.Sqrt(magA) * Mathf.Sqrt(magB));
    }
}